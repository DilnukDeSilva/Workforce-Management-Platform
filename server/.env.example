# HTTP port the server listens on. Defaults to 5000 if unset.
PORT=5000

# MongoDB connection string. Required — the server will not start without it.
# Local MongoDB example:
MONGODB_URI=mongodb://localhost:27017/wfm

# MongoDB Atlas / remote example (replace with your own credentials):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-url>/wfm?retryWrites=true&w=majority
