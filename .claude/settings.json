{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run verify*)",
      "Bash(npm run test:harness*)",
      "Bash(npm run aidlc -- status*)",
      "Bash(npm run aidlc -- next*)",
      "Bash(npm run aidlc -- list*)",
      "Bash(npm run aidlc -- check*)",
      "Bash(npm run aidlc -- ready *)",
      "Bash(npm run aidlc -- unit *)",
      "Bash(npm run aidlc -- units sync*)",
      "Bash(npm run aidlc -- record *)",
      "Bash(npm run aidlc -- log *)",
      "Bash(npm run lint --workspace client*)",
      "Bash(npm run build --workspace client*)",
      "Bash(npm test --workspace server*)",
      "Bash(node --test *)",
      "Bash(node --check *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch --show-current)",
      "Bash(date -u*)"
    ],
    "deny": [
      "Bash(git commit*)",
      "Bash(git push*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Edit(**/.env)",
      "Write(**/.env)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-context.mjs\"", "timeout": 10 }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.mjs\"", "timeout": 10 }]
      },
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-files.mjs\"", "timeout": 10 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-check.mjs\"", "timeout": 30 }]
      }
    ]
  }
}
