{
  "name": "workforce-management-platform",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "dev": "concurrently -n client,server -c blue,green \"npm:dev:client\" \"npm:dev:server\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
