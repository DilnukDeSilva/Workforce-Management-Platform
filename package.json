{
  "name": "workforce-management-platform",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "dev": "concurrently -n client,server -c blue,green \"npm:dev:client\" \"npm:dev:server\"",
    "verify": "node scripts/verify.mjs",
    "verify:quick": "node scripts/verify.mjs --quick",
    "aidlc": "node scripts/aidlc/cli.mjs",
    "test:harness": "node --test \"scripts/aidlc/*.test.mjs\"",
    "format": "prettier --write \"{client,server}/**/*.{js,jsx,mjs,cjs}\"",
    "format:check": "prettier --check \"{client,server}/**/*.{js,jsx,mjs,cjs}\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.10.1"
  },
  "engines": {
    "node": ">=20"
  }
}
